# Digital Jeeva360 — Hostinger / LiteSpeed configuration

# Never show raw directory listings
Options -Indexes
DirectorySlash Off

RewriteEngine On

# Force https and a single host (uncomment the www line you prefer if needed)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Retired pages -> 301 (must sit ABOVE the clean-URL rule)
# /results.html was removed Aug 2026; redirect rather than 404 so any
# existing index entry or inbound link lands somewhere useful.
RewriteRule ^results\.html$ / [R=301,L]
RewriteRule ^results/?$ / [R=301,L]

# Clean URLs: /contact -> /contact.html, /services -> /services.html,
# /services/seo -> /services/seo.html (also handles trailing slashes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# Custom 404 page
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
